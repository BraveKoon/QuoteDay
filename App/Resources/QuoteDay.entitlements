<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.quoteday.app</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.quoteday.app</string>
	</array>
	<!-- Sign in with Apple. 서버가 없는 앱이라 토큰을 보내지는 않고,
	     사용자가 본인 Apple 계정으로 들어왔다는 사실만 확인한다. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- 기기 안 AI(Qwen3 4B, 가중치만 2.3GB). 기본 한도로는 적재 중에 iOS 가 앱을 내린다.
	     8GB 기기에서 앱이 쓸 수 있는 메모리를 늘려 달라고 요청한다. 위젯에는 넣지 않는다. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
